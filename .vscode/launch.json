{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cine Estrella - Interfaz Gráfica (GUI v3)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Cine Estrella - Modo Consola (CLI v2)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--consola"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Ejecutar Todas las Pruebas Unitarias",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": ["discover", "tests"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
